[app]
title = Ruijie Login Tool
package.name = ruijielogin
package.domain = org.spx.ruijie
# ဒီနေရာမှာ အစက် (.) လေးကို မေ့မကျန်ပါစေနဲ့
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 1.0
requirements = python3,kivy,aiohttp,certifi
android.permissions = INTERNET
# SDK 33 က တည်ငြိမ်ပါတယ်
android.api = 34
android.minapi = 21
android.sdk = 34
android.ndk = 27.3.13750724
android.archs = arm64-v8a
